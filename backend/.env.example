PORT=5000
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_EXPIRES_IN=7d
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=

# Payment Gateway Configuration (Phase 11)
# Options: 'webcraft_pay' (default secure built-in engine), 'stripe', 'paypal'
PAYMENT_PROVIDER=webcraft_pay
PAYMENT_WEBHOOK_SECRET=your_webhook_signing_secret_min_32_chars
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Real Email & Notification Service Configuration (Phase 12)
# Resend API Key (Optional for live delivery; fallback to persistent outbox audit log if unset)
RESEND_API_KEY=re_your_resend_api_key_here
ADMIN_NOTIFICATION_EMAIL=admin@webcraft.ai
EMAIL_FROM=notifications@webcraft.ai
APP_URL=http://localhost:3000
